# Copy to .env and adjust. Values follow the 12-factor environment file used
# by the systemd unit (EnvironmentFile) and compose.

# Host port for the web UI (compose maps it to the container's 8000).
VIBE_WATCHER_WEB_PORT=28888

# Base folder on the host containing the projects to watch. It is mounted
# read-write at /projects in the containers, and folder paths registered
# under it are translated automatically (VIBE_WATCHER_PATH_MAP).
# Defaults to $HOME when unset; example:
#VIBE_WATCHER_PROJECTS_DIR=$HOME/projects
VIBE_WATCHER_SECRET_KEY=change-me-in-production
VIBE_WATCHER_DEBUG=0
VIBE_WATCHER_ALLOWED_HOSTS=localhost,127.0.0.1
VIBE_WATCHER_DB=postgres
POSTGRES_DB=vibewatcher
POSTGRES_USER=vibewatcher
POSTGRES_PASSWORD=vibewatcher
POSTGRES_HOST=db
WATCHER_NOTIFY_BACKEND=none
WATCHER_NOTIFY_APP_NAME=vibe-watcher
WATCHER_HEARTBEAT_STALE_AFTER=180
WATCHER_DEFAULT_POLL_INTERVAL=30
WATCHER_GIT_TIMEOUT=120
WATCHER_LOG_LEVEL=INFO
