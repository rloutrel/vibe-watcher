# vibe-watcher environment file (12-factor configuration)
# System mode: /etc/vibe-watcher/env
# User mode:   ~/.config/vibe-watcher/env

DJANGO_SETTINGS_MODULE=vibe_watcher.settings
VIBE_WATCHER_SECRET_KEY=change-me-in-production
VIBE_WATCHER_DEBUG=0
VIBE_WATCHER_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: omit VIBE_WATCHER_DB (or leave unset) to use SQLite at VIBE_WATCHER_DB_PATH.
# Set VIBE_WATCHER_DB=postgres to use the postgres block below.
#VIBE_WATCHER_DB=postgres
#VIBE_WATCHER_DB_PATH=/var/lib/vibe-watcher/db.sqlite3
#POSTGRES_DB=vibewatcher
#POSTGRES_USER=vibewatcher
#POSTGRES_PASSWORD=vibewatcher
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5432

# Notification backend: dbus (notify-send on the session bus) or none.
WATCHER_NOTIFY_BACKEND=dbus
WATCHER_NOTIFY_APP_NAME=vibe-watcher
# Extra args passed verbatim to notify-send, e.g.:
#WATCHER_NOTIFY_SEND_ARGS=--icon=git --transient

# Watcher tuning
WATCHER_HEARTBEAT_STALE_AFTER=180
WATCHER_DEFAULT_POLL_INTERVAL=300
WATCHER_GIT_TIMEOUT=120
WATCHER_LOG_LEVEL=INFO

# --- Only relevant in system mode (D-Bus session notifications) ---
# The system service has no session bus by default. Point DBUS_SESSION_BUS_ADDRESS
# at your session bus, e.g. (find the address in your desktop session):
#DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
